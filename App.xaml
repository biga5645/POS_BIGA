<Application x:Class="POS_BIGA.App"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="clr-namespace:POS_BIGA.ViewModels"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         xmlns:svc="clr-namespace:POS_BIGA.Services"
         xmlns:print="clr-namespace:POS_BIGA.Infrastructure.Printing.Services"
         xmlns:behaviors="clr-namespace:POS_BIGA.Behaviors"
         xmlns:conv="clr-namespace:POS_BIGA.Converters">

     <Application.Resources>
         <ResourceDictionary>
             <ResourceDictionary.MergedDictionaries>
                 <!-- ✅ Optimized: Red/Orange theme (faster loading) -->
                 <materialDesign:BundledTheme BaseTheme="Light" 
                                            PrimaryColor="Red" 
                                            SecondaryColor="Orange" />

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <ResourceDictionary Source="/POS_BIGA;component/Resources/Styles/ProductCard.xaml" />

             </ResourceDictionary.MergedDictionaries>

             <!-- 🎨 Global Color Palette -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0288D1" />
            <SolidColorBrush x:Key="BackgroundBrush" Color="#ECEFF1" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#388E3C" />
            <SolidColorBrush x:Key="DangerBrush" Color="#D32F2F" />

             <!-- ✅ Global Responsive Window Scaling -->
             <Style TargetType="Window" x:Key="GlobalResponsiveWindowStyle">
                 <Setter Property="behaviors:ResponsiveWindowBehavior.Enable" Value="True" />
                 <Setter Property="behaviors:ResponsiveWindowBehavior.DesignWidth" Value="1600" />
                 <Setter Property="behaviors:ResponsiveWindowBehavior.DesignHeight" Value="900" />
                 <Setter Property="behaviors:ResponsiveWindowBehavior.MinScale" Value="0.75" />
                 <Setter Property="behaviors:ResponsiveWindowBehavior.MaxScale" Value="1.25" />
                 <Setter Property="LayoutTransform">
                     <Setter.Value>
                         <ScaleTransform
                             ScaleX="{Binding RelativeSource={RelativeSource Self}, Path=(behaviors:ResponsiveWindowBehavior.Scale)}"
                             ScaleY="{Binding RelativeSource={RelativeSource Self}, Path=(behaviors:ResponsiveWindowBehavior.Scale)}" />
                     </Setter.Value>
                 </Setter>
             </Style>

             <Style TargetType="Window" BasedOn="{StaticResource GlobalResponsiveWindowStyle}" />

             <!-- ✅ Singleton Services -->
             <svc:AppStateService x:Key="AppStateService" />

             <!-- ✅ Common Converters (cached) -->
             <BooleanToVisibilityConverter x:Key="BoolToVis" />
             <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
             <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
             <conv:CountGrantedConverter x:Key="CountGrantedConverter"/>
         </ResourceDictionary>
     </Application.Resources>
 </Application>

