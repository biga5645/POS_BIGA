<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:local="clr-namespace:POS_BIGA.Models"
    xmlns:conv="clr-namespace:POS_BIGA.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    <conv:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
    <conv:NegativeToBrushConverter x:Key="NegativeToBrush" NegativeBrush="DarkRed" PositiveBrush="Black" />

    <!-- 🎨 Color Palette - must be defined here for ProductCard -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#388E3C" />

    <!-- Button style for entire product card (smooth animations) -->
    <Style x:Key="ProductCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                           To="1.03" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                           To="1.03" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                           To="1" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                           To="1" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                           To="0.97" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                           To="0.97" Duration="0:0:0.08"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- DataTemplate for product card (implicit by DataType) -->
    <DataTemplate DataType="{x:Type local:Product}">
        <!-- entire card acts as a touch-friendly button -->
        <Button Style="{StaticResource ProductCardButtonStyle}"
                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                Cursor="Hand"
                ToolTip="اضغط لإضافة المنتج إلى السلة"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                MaxWidth="260">
            <Border Height="280" Margin="6" Background="White" CornerRadius="8" MaxWidth="248">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.10" />
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                <Setter Property="Background" Value="#FFF8E1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Image area -->
                <Border Grid.Row="0" CornerRadius="8,8,0,0" Background="#F5F5F5" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding ImageUrl, Converter={StaticResource StringToImageSourceConverter}}" 
                              Stretch="Uniform"
                              StretchDirection="DownOnly"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}}"
                              RenderOptions.BitmapScalingMode="HighQuality"
                              Margin="4" />
                        
                        <!-- Placeholder icon -->
                        <materialDesign:PackIcon Kind="PackageVariant" Width="56" Height="56" 
                                                HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                Foreground="#BDBDBD" Opacity="0.5"
                                                Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}" />
                        
                        <!-- Stock status badge -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                                Background="#E53935" CornerRadius="5" Padding="7,3" Margin="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="نفذت الكمية" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                        
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                                Background="#FF9800" CornerRadius="5" Padding="7,3" Margin="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="كمية قليلة" FontSize="10" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Product Info -->
                <StackPanel Grid.Row="1" Margin="10,8,10,6">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap" 
                              HorizontalAlignment="Center" TextAlignment="Center" 
                              FontSize="14" Foreground="#263238" LineHeight="18" MaxHeight="36"
                              TextTrimming="CharacterEllipsis" />
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <Border Background="#E3F2FD" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="{Binding CategoryName}" FontSize="10" 
                                      Foreground="#1976D2" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding Barcode}" FontSize="10" Foreground="#90A4AE" 
                              HorizontalAlignment="Center" Margin="0,3,0,0" FontFamily="Consolas" />
                 </StackPanel>

                <!-- Price & Stock Footer -->
                <Border Grid.Row="2" Background="#FAFAFA" Padding="10,8" 
                        CornerRadius="0,0,8,8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Price, StringFormat={}{0:N2} د.م}" 
                                      FontWeight="Bold" FontSize="18" 
                                      Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{Binding StockQuantity, StringFormat={}{0:N1} متوفر}" 
                                      FontSize="10" Foreground="#607D8B" Margin="0,1,0,0" />
                        </StackPanel>
                        
                        <Border Grid.Column="1" Background="{StaticResource PrimaryBrush}" 
                                CornerRadius="7" Padding="8" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>

                </Grid>
            </Border>
        </Button>
    </DataTemplate>

    <!-- DataTemplate for category card (implicit by DataType) -->
    <DataTemplate DataType="{x:Type local:Category}">
        <!-- entire category card acts as a touch-friendly button (same style as product cards) -->
        <Button Style="{StaticResource ProductCardButtonStyle}" Command="{Binding DataContext.ShowCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Cursor="Hand" ToolTip="اضغط لعرض منتجات الصنف" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="250">
            <Border Height="220" Margin="6" Padding="6" Background="White" CornerRadius="8" BorderBrush="#E8E8E8" BorderThickness="1" MaxWidth="238">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="8" Background="#FAFAFA" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ImageUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                   Stretch="Uniform"
                                   StretchDirection="DownOnly"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="4"
                                   Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}}" />
                            <materialDesign:PackIcon Kind="Folder" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="6,6,6,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <DockPanel Grid.Row="2" Margin="6,6,6,0">
                        <TextBlock Text="" FontWeight="Bold" Foreground="Green" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Border>
        </Button>
    </DataTemplate>

</ResourceDictionary>