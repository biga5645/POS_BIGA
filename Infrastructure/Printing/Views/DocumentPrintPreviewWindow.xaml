<Window x:Class="POS_BIGA.Infrastructure.Printing.Views.DocumentPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title=" معاينة قبل الطباعة"
        Height="780" Width="980"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="FileEye" Width="22" Height="22" Margin="0,0,8,0"/>
            <TextBlock x:Name="TitleText" Text="معاينة قبل الطباعة" FontSize="18" FontWeight="Bold"/>
        </StackPanel>

        <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  IsToolBarVisible="True"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="تأكيد الطباعة" Width="140" Margin="0,0,8,0" Click="Print_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Content="إغلاق" Width="120" Click="Close_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>
