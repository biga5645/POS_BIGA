<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="إدارة المنتجات" FlowDirection="RightToLeft">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <TextBlock Text="قائمة المنتجات" FontSize="18" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBox Width="220" Margin="8,0" materialDesign:HintAssist.Hint="ابحث عن منتج..." Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Category filter -->
            <ComboBox Width="160" Margin="8,0" ItemsSource="{Binding FilterCategories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategoryFilter}" />

            <Button Content="بحث" Style="{DynamicResource MaterialDesignRaisedButton}" Margin="8,0" Command="{Binding SearchCommand}" />

            <Expander Header="بحث متقدم" IsExpanded="{Binding IsAdvancedSearchVisible}" Margin="8,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="100" Margin="4,0" materialDesign:HintAssist.Hint="سعر أدنى" Text="{Binding MinPriceText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Width="100" Margin="4,0" materialDesign:HintAssist.Hint="سعر أقصى" Text="{Binding MaxPriceText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="متوفر فقط" Margin="8,0" IsChecked="{Binding InStockOnly}" VerticalAlignment="Center" />
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إضافة" Style="{DynamicResource MaterialDesignRaisedButton}" Margin="8,0"
                        Command="{Binding AddProductCommand}"
                        Visibility="{Binding CanAddProduct, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="تعديل" Style="{DynamicResource MaterialDesignFlatButton}" Margin="8,0"
                        Command="{Binding EditProductCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=ProductsGrid}"
                        Visibility="{Binding CanEditProduct, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="حذف" Style="{DynamicResource MaterialDesignFlatButton}" Margin="8,0"
                        Command="{Binding DeleteProductCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=ProductsGrid}"
                        Visibility="{Binding CanDeleteProduct, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Auto"
                     PanningMode="Both">
            <DataGrid x:Name="ProductsGrid" ItemsSource="{Binding Products}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeaderWidth="0" SelectionMode="Single"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="الصورة" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Width="60" Height="60" CornerRadius="6" Background="#FAFAFA">
                                <Image Source="{Binding ImageUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                       Stretch="Uniform" Width="60" Height="60"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="120" />
                <DataGridTextColumn Header="الفئة" Binding="{Binding Category.Name}" Width="120" />
                <DataGridTextColumn Header="الكمية" Binding="{Binding StockQuantity}" Width="90" />
                <DataGridTextColumn Header="السعر" Binding="{Binding Price, StringFormat={}{0:N2} د.م}" Width="120" />

                <DataGridTemplateColumn Header="الإجراءات" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="بيع" Width="60" Height="28" Margin="4,0"
                                        Style="{DynamicResource MaterialDesignRaisedButton}"
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="تفاصيل" Width="80" Height="28" Margin="4,0" Style="{DynamicResource MaterialDesignFlatButton}" Command="{Binding DataContext.ShowProductDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Grid>
</Page>