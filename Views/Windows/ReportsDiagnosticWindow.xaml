<Window x:Class="POS_BIGA.Views.Windows.ReportsDiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="🔧 تشخيص بيانات التقارير" 
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#1976D2"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <materialDesign:Card Grid.Row="0" Padding="20,16" Margin="20,20,20,16" 
                             UniformCornerRadius="12" Effect="{StaticResource CardShadow}"
                             Background="{StaticResource InfoBrush}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Tools" Foreground="White" Width="32" Height="32" 
                                        VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel>
                    <TextBlock Text="أداة تشخيص بيانات التقارير" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="لحل مشكلة ظهور الأصفار في واجهة التقارير" 
                              Foreground="White" FontSize="13" Opacity="0.9" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Content -->
        <materialDesign:Card Grid.Row="1" Padding="24" Margin="20,0,20,16" 
                            UniformCornerRadius="12" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Buttons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                    <Button x:Name="VerifyButton" 
                           Width="180" Height="48" Margin="0,0,12,0"
                           Click="VerifyData_Click"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="{StaticResource InfoBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="التحقق من البيانات" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CreateTestButton"
                           Width="180" Height="48"
                           Click="CreateTestData_Click"
                           Style="{StaticResource MaterialDesignOutlinedButton}"
                           BorderBrush="{StaticResource SuccessBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TestTube" Width="20" Height="20" Margin="0,0,8,0"
                                                    Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="إنشاء بيانات اختبار" FontSize="14" 
                                      Foreground="{StaticResource SuccessBrush}" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Results -->
                <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="8" 
                       BorderBrush="#E0E0E0" BorderThickness="1" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ResultTextBlock"
                                  Text="اضغط على 'التحقق من البيانات' لبدء التشخيص..."
                                  FontFamily="Consolas"
                                  FontSize="13"
                                  TextWrapping="Wrap"
                                  Foreground="#333"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </materialDesign:Card>

        <!-- Footer -->
        <materialDesign:Card Grid.Row="2" Padding="20,16" Margin="20,0,20,20" 
                            UniformCornerRadius="12" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <Border Background="#FFF3E0" BorderBrush="#FF9800" BorderThickness="1" 
                       CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Information" Width="20" Height="20" 
                                                Foreground="#F57C00" 
                                                VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#E65100">
                            <Run Text="💡 ملاحظة:" FontWeight="Bold"/>
                            <Run Text="إذا كانت البيانات فارغة، قم ببيع بعض المنتجات أولاً من الشاشة الرئيسية."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button Width="120" Height="40" HorizontalAlignment="Right"
                       Click="Close_Click"
                       Style="{StaticResource MaterialDesignFlatButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="إغلاق"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
