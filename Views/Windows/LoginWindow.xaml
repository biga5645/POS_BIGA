<Window x:Class="POS_BIGA.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title=" تسجيل الدخول - POS BIGA"
        Height="560" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- زر رقمي لـ PIN -->
        <Style x:Key="PinButton" TargetType="Button">
            <Setter Property="Width"  Value="64"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- الحاوية الرئيسية -->
    <Border CornerRadius="16" Background="#1E1E2E"
            BorderBrush="#3A3A5A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- شريط العنوان -->
            <Border Grid.Row="0" Background="#16162A" CornerRadius="16,16,0,0"
                    Padding="16,12" MouseDown="TitleBar_MouseDown" Cursor="SizeAll">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="🏪" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="POS BIGA" FontSize="16" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Left"
                            Background="Transparent" Foreground="#888" BorderThickness="0"
                            FontSize="16" Cursor="Hand" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- المحتوى -->
            <Grid Grid.Row="1" Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- العنوان -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="تسجيل الدخول " FontSize="22" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="أدخل بيانات حسابك للمتابعة " FontSize="12"
                               Foreground="#888" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- TabControl: PIN / كلمة مرور -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                            Foreground="White" x:Name="LoginTabControl"
                            SelectedIndex="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="#AAA"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Padding="{TemplateBinding Padding}"
                                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#7C6AF5"/>
                                                <Setter Property="Foreground" Value="#7C6AF5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- تبويب PIN — الافتراضي -->
                    <TabItem Header="🔢  رمز PIN">
                        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                            <!-- عرض الأرقام المدخلة -->
                            <Border Background="#2A2A3E" CornerRadius="10" Padding="16,12"
                                    Margin="0,0,0,4" MinWidth="220" HorizontalAlignment="Center"
                                    BorderBrush="#7C6AF5" BorderThickness="1">
                                <TextBlock Text="{Binding PinDisplay}"
                                           FontSize="28" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- تلميح لوحة المفاتيح -->
                            <TextBlock Text="يمكنك استخدام لوحة المفاتيح الرقمية"
                                       FontSize="10" Foreground="#555"
                                       HorizontalAlignment="Center" Margin="0,2,0,12"/>

                            <!-- لوحة الأرقام -->
                            <Grid HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource PinButton}" Command="{Binding AppendPinCommand}" CommandParameter="1"/>
                                <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource PinButton}" Command="{Binding AppendPinCommand}" CommandParameter="2"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource PinButton}" Command="{Binding AppendPinCommand}" CommandParameter="3"/>
                                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource PinButton}" Command="{Binding AppendPinCommand}" CommandParameter="4"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource PinButton}" Command="{Binding AppendPinCommand}" CommandParameter="5"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource PinButton}" Command="{Binding AppendPinCommand}" CommandParameter="6"/>
                                <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource PinButton}" Command="{Binding AppendPinCommand}" CommandParameter="7"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource PinButton}" Command="{Binding AppendPinCommand}" CommandParameter="8"/>
                                <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource PinButton}" Command="{Binding AppendPinCommand}" CommandParameter="9"/>
                                <Button Grid.Row="3" Grid.Column="0" Content="⌫" Style="{StaticResource PinButton}"
                                        Command="{Binding ClearPinCommand}" Foreground="#F87171"
                                        ToolTip="مسح آخر رقم"/>
                                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource PinButton}"
                                        Command="{Binding AppendPinCommand}" CommandParameter="0"/>
                                <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource PinButton}"
                                        Command="{Binding ClearPinCommand}" Foreground="#F87171"
                                        ToolTip="مسح آخر رقم"/>

                                <!-- مسح كامل -->
                                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                        Content="مسح الكل" Height="36" Margin="4,6,4,0"
                                        FontSize="12" Cursor="Hand" Foreground="#888"
                                        Background="Transparent" BorderBrush="#333" BorderThickness="1"
                                        Command="{Binding ClearAllPinCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <!-- تبويب كلمة المرور -->
                    <TabItem Header="🔑  كلمة المرور">
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="اسم المستخدم" Foreground="#AAA" FontSize="12" Margin="0,0,0,6"/>
                            <Border Background="#2A2A3E" CornerRadius="8" Padding="12,10"
                                    BorderBrush="#3A3A5A" BorderThickness="1" Margin="0,0,0,14">
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" Foreground="White" BorderThickness="0"
                                         FontSize="14" CaretBrush="White" x:Name="UsernameBox"/>
                            </Border>

                            <TextBlock Text="كلمة المرور" Foreground="#AAA" FontSize="12" Margin="0,0,0,6"/>
                            <Border Background="#2A2A3E" CornerRadius="8" Padding="12,10"
                                    BorderBrush="#3A3A5A" BorderThickness="1" Margin="0,0,0,20">
                                <PasswordBox x:Name="PasswordBox" Background="Transparent"
                                             Foreground="White" BorderThickness="0" FontSize="14"
                                             CaretBrush="White"
                                             PasswordChanged="PasswordBox_PasswordChanged"
                                             KeyDown="PasswordBox_KeyDown"/>
                            </Border>

                            <Button Content="تسجيل الدخول" Command="{Binding LoginCommand}"
                                    Height="44" FontSize="15" FontWeight="Bold"
                                    Cursor="Hand" Foreground="White">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="#7C6AF5" CornerRadius="8">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- رسالة الخطأ -->
                <Border Grid.Row="2" Background="#3B1515" CornerRadius="8" Padding="12,10"
                        Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171"
                               FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
