<Window x:Class="POS_BIGA.Views.Windows.CustomerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:POS_BIGA.ViewModels"
        xmlns:behaviors="clr-namespace:POS_BIGA.Behaviors"
        Title="{Binding Title}" 
        Height="800" Width="900"
        MinHeight="700" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MaterialDesignPaper}"
        ResizeMode="CanResize"
        behaviors:WindowCloseBehavior.DialogResult="{Binding DialogResult}">

    <Window.DataContext>
        <vm:CustomerEditorViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F44336"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🎯 Header -->
        <materialDesign:Card Grid.Row="0" Padding="24,20" Margin="0" 
                             UniformCornerRadius="0" 
                             Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <materialDesign:PackIcon Grid.Column="0" Kind="AccountPlus" 
                                        Foreground="White" Width="36" Height="36" 
                                        VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" 
                              Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="أدخل معلومات العميل الكاملة"
                              Foreground="White" FontSize="13" Opacity="0.9" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Command="{Binding CancelCommand}"
                       Style="{StaticResource MaterialDesignIconButton}"
                       ToolTip="إغلاق"
                       Width="40" Height="40">
                    <materialDesign:PackIcon Kind="Close" Width="24" Height="24" Foreground="White"/>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- 📝 Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,24,30,24">

                <!-- 👤 الاسم الكامل -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16" 
                                    UniformCornerRadius="10" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Account" Width="20" Height="20" 
                                                    Foreground="{StaticResource PrimaryBrush}" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="المعلومات الشخصية" FontSize="16" FontWeight="SemiBold" 
                                      Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>

                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="الاسم الكامل *"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                FontSize="15" Margin="0,0,0,16" Height="56"/>

                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="رقم الهاتف (اختياري)"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                FontSize="15" Margin="0,0,0,16" Height="56">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="البريد الإلكتروني (اختياري)"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                FontSize="15" Height="56"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 📍 العنوان -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16" 
                                    UniformCornerRadius="10" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="MapMarker" Width="20" Height="20" 
                                                    Foreground="{StaticResource PrimaryBrush}" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="معلومات العنوان" FontSize="16" FontWeight="SemiBold" 
                                      Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>

                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="العنوان الكامل"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextWrapping="Wrap" AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                FontSize="15" Height="80"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 💰 سقف الدين -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16" 
                                    UniformCornerRadius="10" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="CreditCard" Width="20" Height="20" 
                                                    Foreground="{StaticResource PrimaryBrush}" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="إعدادات الائتمان" FontSize="16" FontWeight="SemiBold" 
                                      Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>

                        <TextBox Text="{Binding CreditLimitText, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="سقف الدين (د.م)"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                FontSize="15" Height="56" Margin="0,0,0,12">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Border Background="#E3F2FD" BorderBrush="{StaticResource PrimaryBrush}" 
                               BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Information" Width="18" Height="18" 
                                                        Foreground="{StaticResource PrimaryBrush}" 
                                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" 
                                          Foreground="{StaticResource PrimaryBrush}">
                                    <Run Text="💡 نصيحة:" FontWeight="Bold"/>
                                    <LineBreak/>
                                    <Run Text="سقف الدين هو الحد الأقصى للمبلغ الذي يمكن للعميل الشراء به بالدين. "/>
                                    <Run Text="اتركه 0 إذا كنت لا تريد السماح بالبيع بالدين لهذا العميل."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 📝 ملاحظات -->
                <materialDesign:Card Padding="20" Margin="0,0,0,0" 
                                    UniformCornerRadius="10" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="NoteText" Width="20" Height="20" 
                                                    Foreground="{StaticResource PrimaryBrush}" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="ملاحظات إضافية" FontSize="16" FontWeight="SemiBold" 
                                      Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>

                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="أي ملاحظات أخرى عن العميل (اختياري)"
                                materialDesign:HintAssist.IsFloating="True"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                TextWrapping="Wrap" AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                FontSize="14" Height="100"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ✅ Footer with Action Buttons -->
        <materialDesign:Card Grid.Row="2" Padding="20,16" Margin="0" 
                             UniformCornerRadius="0" 
                             Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- معلومة إضافية -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AlertCircle" Width="16" Height="16" 
                                            Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="الحقول المعلمة بـ (*) مطلوبة" 
                              FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- زر الإلغاء -->
                <Button Grid.Column="1" Command="{Binding CancelCommand}"
                       Width="120" Height="40" Margin="0,0,12,0"
                       Style="{StaticResource MaterialDesignOutlinedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="إلغاء" FontSize="14"/>
                    </StackPanel>
                </Button>

                <!-- زر الحفظ -->
                <Button Grid.Column="2" Command="{Binding SaveCommand}"
                       Width="140" Height="40"
                       Style="{StaticResource MaterialDesignRaisedButton}"
                       Background="{StaticResource SuccessBrush}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="حفظ العميل" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
