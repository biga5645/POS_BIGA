<Window x:Class="POS_BIGA.Views.Windows.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:POS_BIGA.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="التقارير والإحصائيات الشاملة" 
        WindowState="Maximized"
        MinHeight="760" MinWidth="1100"
        FlowDirection="RightToLeft" 
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        SizeChanged="ReportsWindow_SizeChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E74C3C"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F39C12"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#3498DB"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#9B59B6"/>
        <SolidColorBrush x:Key="TealBrush" Color="#1ABC9C"/>

        <LinearGradientBrush x:Key="SalesGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3498DB" Offset="0"/>
            <GradientStop Color="#2C7FB8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ProfitGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#27AE60" Offset="0"/>
            <GradientStop Color="#1E8449" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="InvoiceGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F39C12" Offset="0"/>
            <GradientStop Color="#D68910" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AverageGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9B59B6" Offset="0"/>
            <GradientStop Color="#7D3C98" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GrowthGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1ABC9C" Offset="0"/>
            <GradientStop Color="#148F77" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CreditGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E74C3C" Offset="0"/>
            <GradientStop Color="#C0392B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PaidGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#27AE60" Offset="0"/>
            <GradientStop Color="#1E8449" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RemainingGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F39C12" Offset="0"/>
            <GradientStop Color="#CA6F1E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CustomersGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9B59B6" Offset="0"/>
            <GradientStop Color="#76448A" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="StatCard" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="UniformCornerRadius" Value="8"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>

        <Style x:Key="StatTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="ModernSectionCard" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="UniformCornerRadius" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <Style x:Key="ReportGridHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="ReportGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" Effect="{StaticResource CardShadow}">
            <Grid x:Name="HeaderGrid" Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="{StaticResource AccentBrush}" 
                            CornerRadius="12" Padding="14" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="ChartBox" Foreground="White" Width="36" Height="36"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="التقارير والإحصائيات" FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="لوحة احترافية لتحليل المبيعات، الأرباح، الديون والأداء" 
                                   FontSize="13" Opacity="0.6" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Click="Close_Click"
                       Style="{StaticResource MaterialDesignIconButton}"
                       ToolTip="إغلاق" Width="44" Height="44">
                    <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content with Tabs -->
        <materialDesign:Card Grid.Row="1" Margin="20,16,20,20" 
                             UniformCornerRadius="16" Effect="{StaticResource CardShadow}">
            <TabControl Style="{StaticResource MaterialDesignFilledTabControl}"
                        TabStripPlacement="Top"
                        materialDesign:ColorZoneAssist.Mode="PrimaryMid"
                        FontSize="13"
                        Padding="0">

                <!-- Tab 1: الملخص -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="12,6">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="الملخص العام" FontSize="13" FontWeight="SemiBold" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,4,0">
                        <StackPanel Margin="20,16,20,20">
                            <!-- Filter -->
                            <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="10" Background="White">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0" Kind="Filter" Width="24" Height="24" 
                                                                Foreground="{StaticResource AccentBrush}" 
                                                                VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <ComboBox Grid.Column="1" ItemsSource="{Binding PeriodOptions}"
                                                  SelectedItem="{Binding SelectedPeriod}"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="الفترة"
                                                  FontSize="13" Height="48" Margin="0,0,12,0"/>

                                        <DatePicker Grid.Column="2" SelectedDate="{Binding StartDate}" 
                                                   materialDesign:HintAssist.Hint="من"
                                                   Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                   Margin="0,0,8,0" Height="48"/>

                                        <DatePicker Grid.Column="3" SelectedDate="{Binding EndDate}"
                                                   materialDesign:HintAssist.Hint="إلى"
                                                   Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                   Margin="8,0,12,0" Height="48"/>

                                        <Button Grid.Column="4" Width="120" Height="42"
                                                Command="{Binding RefreshCommand}" 
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Background="{StaticResource AccentBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/>
                                                <TextBlock Text="تحديث" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                                            <Button Width="48" Height="48" Margin="0,0,6,0"
                                                    Command="{Binding ExportExcelCommand}" 
                                                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                                                    Background="{StaticResource SuccessBrush}"
                                                    ToolTip="تصدير Excel">
                                                <materialDesign:PackIcon Kind="MicrosoftExcel" Width="22" Height="22"/>
                                            </Button>

                                            <Button Width="48" Height="48" Margin="0,0,6,0"
                                                    Command="{Binding ExportPdfCommand}" 
                                                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                                                    Background="{StaticResource AccentBrush}"
                                                    ToolTip="تصدير PDF">
                                                <materialDesign:PackIcon Kind="FilePdfBox" Width="22" Height="22"/>
                                            </Button>

                                            <Button Width="48" Height="48" Margin="0,0,6,0"
                                                    Command="{Binding PrintCommand}" 
                                                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                                                    Background="{StaticResource InfoBrush}"
                                                    ToolTip="معاينة وطباعة التقرير - A4/A5">
                                                <materialDesign:PackIcon Kind="Printer" Width="22" Height="22"/>
                                            </Button>

                                            <Button Width="48" Height="48" Margin="6,0,0,0"
                                                    Command="{Binding PrintThermalCommand}" 
                                                    Style="{StaticResource MaterialDesignFloatingActionButton}"
                                                    Background="#FF6B35"
                                                    ToolTip="معاينة وطباعة التقرير - طابعة حرارية">
                                                <materialDesign:PackIcon Kind="PrinterPos" Width="22" Height="22"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </materialDesign:Card>

                            <!-- Loading -->
                            <materialDesign:Card Padding="14" Background="#FFF3CD" Margin="0,0,0,16"
                                                Visibility="{Binding IsLoading,Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                                 IsIndeterminate="True" Width="28" Height="28" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <!-- Stats Cards -->
                            <Grid x:Name="StatsCardsContainer" Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Sales Stats -->
                                <UniformGrid x:Name="SalesStatsGrid" Grid.Row="0" Columns="5" Rows="1" Margin="2,0,2,0">
                                    <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource SalesGradient}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="CashMultiple" Width="22" Height="22" 
                                                                    Foreground="White" Opacity="0.9" Margin="0,0,0,4"/>
                                            <TextBlock Text="إجمالي المبيعات" Style="{StaticResource StatTitle}" Foreground="White"/>
                                            <TextBlock Text="{Binding TotalSales, StringFormat={}{0:N2} د.م}" 
                                                      Style="{StaticResource StatValue}" Foreground="White"/>
                                            <TextBlock Text="آخر تحديث لحظي" FontSize="9" Foreground="White" Opacity="0.8" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource ProfitGradient}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="TrendingUp" Width="22" Height="22" 
                                                                    Foreground="White" Opacity="0.9" Margin="0,0,0,4"/>
                                            <TextBlock Text="إجمالي الأرباح" Style="{StaticResource StatTitle}" Foreground="White"/>
                                            <TextBlock Text="{Binding TotalProfit, StringFormat={}{0:N2} د.م}" 
                                                      Style="{StaticResource StatValue}" Foreground="White"/>
                                            <TextBlock Text="{Binding ProfitMarginFormatted, StringFormat='هامش: {0}'}" 
                                                      FontSize="9" Foreground="White" Opacity="0.9" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource InvoiceGradient}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Receipt" Width="22" Height="22" 
                                                                    Foreground="White" Opacity="0.9" Margin="0,0,0,4"/>
                                            <TextBlock Text="عدد الفواتير" Style="{StaticResource StatTitle}" Foreground="White"/>
                                            <TextBlock Text="{Binding InvoicesCount}" 
                                                      Style="{StaticResource StatValue}" Foreground="White"/>
                                            <TextBlock Text="الإجمالي خلال الفترة" FontSize="9" Foreground="White" Opacity="0.8" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource AverageGradient}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="ChartLine" Width="22" Height="22" 
                                                                    Foreground="White" Opacity="0.9" Margin="0,0,0,4"/>
                                            <TextBlock Text="معدل الفاتورة" Style="{StaticResource StatTitle}" Foreground="White"/>
                                            <TextBlock Text="{Binding AverageSale, StringFormat={}{0:N2} د.م}" 
                                                      Style="{StaticResource StatValue}" Foreground="White"/>
                                            <TextBlock Text="متوسط لكل عملية بيع" FontSize="9" Foreground="White" Opacity="0.8" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource GrowthGradient}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="22" Height="22" 
                                                                    Foreground="White" Opacity="0.9" Margin="0,0,0,4"/>
                                            <TextBlock Text="نمو المبيعات" Style="{StaticResource StatTitle}" Foreground="White"/>
                                            <TextBlock Text="{Binding SalesGrowthFormatted}" 
                                                      Style="{StaticResource StatValue}" Foreground="White"/>
                                            <TextBlock Text="مقارنة بالفترة السابقة" 
                                                      FontSize="9" Foreground="White" Opacity="0.85" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </UniformGrid>

                                <!-- Credit Stats -->
                                <UniformGrid x:Name="CreditStatsGrid" Grid.Row="1" Columns="4" Rows="1" Margin="2,8,2,0">
                                    <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource CreditGradient}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="CreditCardClock" Width="22" Height="22" 
                                                                    Foreground="White" Opacity="0.9" Margin="0,0,0,4"/>
                                            <TextBlock Text="إجمالي الديون" Style="{StaticResource StatTitle}" Foreground="White"/>
                                            <TextBlock Text="{Binding TotalCredits, StringFormat={}{0:N2} د.م}" 
                                                      Style="{StaticResource StatValue}" Foreground="White"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource PaidGradient}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="CashCheck" Width="22" Height="22" 
                                                                    Foreground="White" Opacity="0.9" Margin="0,0,0,4"/>
                                            <TextBlock Text="المدفوع" Style="{StaticResource StatTitle}" Foreground="White"/>
                                            <TextBlock Text="{Binding PaidCredits, StringFormat={}{0:N2} د.م}" 
                                                      Style="{StaticResource StatValue}" Foreground="White"/>
                                            <TextBlock Text="{Binding CreditPaymentRateFormatted, StringFormat='نسبة: {0}'}" 
                                                      FontSize="9" Foreground="White" Opacity="0.9" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource RemainingGradient}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="AlertCircle" Width="22" Height="22" 
                                                                    Foreground="White" Opacity="0.9" Margin="0,0,0,4"/>
                                            <TextBlock Text="المتبقي" Style="{StaticResource StatTitle}" Foreground="White"/>
                                            <TextBlock Text="{Binding RemainingCredits, StringFormat={}{0:N2} د.م}" 
                                                      Style="{StaticResource StatValue}" Foreground="White"/>
                                        </StackPanel>
                                    </materialDesign:Card>

                                    <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource CustomersGradient}">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="AccountMultiple" Width="22" Height="22" 
                                                                    Foreground="White" Opacity="0.9" Margin="0,0,0,4"/>
                                            <TextBlock Text="الزبائن المدينون" Style="{StaticResource StatTitle}" Foreground="White"/>
                                            <TextBlock Text="{Binding CreditCustomersCount}" 
                                                      Style="{StaticResource StatValue}" Foreground="White"/>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </UniformGrid>
                            </Grid>

                            <!-- Charts -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Daily Sales -->
                                <materialDesign:Card Grid.Column="0" Padding="16" Margin="0,0,8,0" 
                                                    UniformCornerRadius="10" Background="White">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <materialDesign:PackIcon Kind="ChartBar" Width="22" Height="22" 
                                                                    Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="المبيعات اليومية" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Border Height="240" Background="#F8F9FA" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding DailySales}" Margin="10">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" Margin="4" Padding="10" 
                                                                   CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" MinWidth="120">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DayName}" FontSize="10" Opacity="0.6" TextAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DateFormatted}" FontSize="11" 
                                                                              FontWeight="SemiBold" Margin="0,2,0,6" TextAlignment="Center"/>
                                                                    <TextBlock Text="{Binding TotalSales, StringFormat={}{0:N2} د.م}" 
                                                                              FontSize="13" FontWeight="Bold" 
                                                                              Foreground="{StaticResource SuccessBrush}" TextAlignment="Center"/>
                                                                    <TextBlock Text="{Binding InvoicesCount, StringFormat='{}{0} فاتورة'}" 
                                                                              FontSize="9" Opacity="0.7" Margin="0,4,0,0" TextAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- Category Sales -->
                                <materialDesign:Card Grid.Column="1" Padding="16" Margin="8,0,0,0" 
                                                    UniformCornerRadius="10" Background="White">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <materialDesign:PackIcon Kind="ShapeOutline" Width="22" Height="22" 
                                                                    Foreground="{StaticResource PurpleBrush}" Margin="0,0,10,0"/>
                                            <TextBlock Text="حسب الفئات" FontSize="16" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <Border Background="#F8F9FA" CornerRadius="8" BorderBrush="#DEE2E6" BorderThickness="1">
                                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding CategorySales}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" Margin="8" Padding="10" 
                                                                   CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                        <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N2} د.م}" 
                                                                                  FontSize="14" FontWeight="Bold" 
                                                                                  Foreground="{StaticResource SuccessBrush}"/>
                                                                        <TextBlock Text="{Binding PercentageFormatted, StringFormat=' ({0})'}" 
                                                                                  FontSize="11" Opacity="0.6" Margin="6,0,0,0" 
                                                                                  VerticalAlignment="Bottom"/>
                                                                    </StackPanel>
                                                                    <ProgressBar Value="{Binding Percentage}" 
                                                                                Maximum="100" Height="4" Margin="0,6,0,0"
                                                                                Foreground="{StaticResource PurpleBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </materialDesign:Card>
                            </Grid>

                            <!-- Top Products -->
                            <materialDesign:Card Padding="16" UniformCornerRadius="10" Background="White">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <materialDesign:PackIcon Kind="TrophyVariant" Width="22" Height="22" 
                                                                Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="أفضل 10 منتجات" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TopProducts.Count, StringFormat=' ({0} منتج)'}" 
                                                  FontSize="13" Opacity="0.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding TopProducts}" 
                                             AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                             SelectionMode="Single" HeadersVisibility="All" GridLinesVisibility="None"
                                             RowHeight="42" FontSize="12" Background="Transparent"
                                             materialDesign:DataGridAssist.CellPadding="8">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*" MinWidth="160">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="الكمية" Binding="{Binding QuantitySold, StringFormat={}{0:N0}}" Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="الإيرادات" Binding="{Binding TotalRevenue, StringFormat={}{0:N2}}" Width="110">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="الربح" Binding="{Binding TotalProfit, StringFormat={}{0:N2}}" Width="100">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="الهامش" Binding="{Binding ProfitMarginFormatted}" Width="90">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: الفواتير -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="12,6">
                            <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="18" Height="18" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="تفاصيل الفواتير" FontSize="13" FontWeight="SemiBold" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <materialDesign:Card Margin="28,16,28,20" Style="{StaticResource ModernSectionCard}" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="Receipt" Width="24" Height="24"
                                                            Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="جميع الفواتير" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Sales.Count, StringFormat=' ({0} فاتورة)'}"
                                              FontSize="14" Opacity="0.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Grid.Column="1">
                                    <Button Command="{Binding ExportInvoicesPeriodPdfCommand}" 
                                            Style="{StaticResource MaterialDesignRaisedButton}" 
                                            Background="{StaticResource AccentBrush}"
                                            Margin="0,0,8,0"
                                            ToolTip="تصدير فواتير الفترة إلى PDF">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="تصدير PDF"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="SalesDataGrid"
                                     ItemsSource="{Binding Sales}"
                                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                     SelectionMode="Single" HeadersVisibility="All"
                                     GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F9FA"
                                     RowHeight="46" FontSize="12" Background="Transparent"
                                     RowHeaderWidth="0"
                                     Tag="{Binding}"
                                     materialDesign:DataGridAssist.CellPadding="10">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ReportGridHeaderStyle}"/>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ReportGridCellStyle}"/>
                                </DataGrid.Resources>

                                <DataGrid.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="👁️ معاينة الفاتورة"
                                                 Command="{Binding PreviewInvoiceCommand}"
                                                 CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 FontSize="14" FontWeight="SemiBold">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="🖨️ إعادة طباعة الفاتورة"
                                                 Command="{Binding ReprintInvoiceCommand}"
                                                 CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 FontSize="14" FontWeight="SemiBold">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="📄 عرض تفاصيل الفاتورة"
                                                 Command="{Binding ViewInvoiceDetailsCommand}"
                                                 CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 FontSize="14">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="🗑️ حذف الفاتورة"
                                                 Command="{Binding DeleteSaleCommand}"
                                                 CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 FontSize="14" FontWeight="SemiBold"
                                                 Foreground="#E74C3C">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#E74C3C"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding SaleNumber}" Width="125">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="التاريخ" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding SaleDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                              FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock Text="{Binding SaleDate, StringFormat={}{0:HH:mm}}"
                                                              FontSize="10" Opacity="0.6"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*" MinWidth="130"/>
                                    <DataGridTextColumn Header="الأصناف" Binding="{Binding ItemsCount}" Width="70"/>
                                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="95"/>
                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="95"/>
                                    <DataGridTextColumn Header="الربح" Binding="{Binding TotalProfit, StringFormat={}{0:N2}}" Width="95"/>
                                    <DataGridTextColumn Header="الهامش" Binding="{Binding ProfitMarginFormatted}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>
                </TabItem>

                <!-- Tab 3: الديون -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="12,6">
                            <materialDesign:PackIcon Kind="CreditCardOutline" Width="18" Height="18"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="تفاصيل الديون" FontSize="13" FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <materialDesign:Card Margin="28,16,28,20" Style="{StaticResource ModernSectionCard}" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <materialDesign:PackIcon Kind="AccountCash" Width="24" Height="24"
                                                            Foreground="#E74C3C" Margin="0,0,10,0"/>
                                    <TextBlock Text="جميع الديون" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Credits.Count, StringFormat=' ({0} دين)'}"
                                              FontSize="14" Opacity="0.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Grid.Column="1">
                                    <Button Command="{Binding ExportCreditsExcelCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{StaticResource SuccessBrush}"
                                            Margin="0,0,8,0"
                                            ToolTip="تصدير الديون إلى Excel">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MicrosoftExcel" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="تصدير Excel"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding ExportCreditsPdfCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{StaticResource AccentBrush}"
                                            Margin="0,0,8,0"
                                            ToolTip="تصدير الديون إلى PDF">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="تصدير PDF"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding PrintCreditsCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="{StaticResource InfoBrush}"
                                            ToolTip="معاينة وطباعة ملخص الديون">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="طباعة"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding Credits}"
                                     AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                     SelectionMode="Single" HeadersVisibility="All"
                                     GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F9FA"
                                     RowHeight="52" FontSize="12" Background="Transparent"
                                     RowHeaderWidth="0"
                                     materialDesign:DataGridAssist.CellPadding="10">

                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ReportGridHeaderStyle}"/>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ReportGridCellStyle}"/>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*" MinWidth="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="الفاتورة" Binding="{Binding SaleNumber}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDateFormatted}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueDateFormatted}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="الأصلي" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding OriginalAmount, StringFormat={}{0:N2}}"
                                                          FontWeight="Bold" HorizontalAlignment="Center"
                                                          Foreground="#E74C3C"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="المدفوع" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N2}}"
                                                          FontWeight="Bold" HorizontalAlignment="Center"
                                                          Foreground="#27AE60"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="المتبقي" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N2}}"
                                                          FontWeight="Bold" HorizontalAlignment="Center"
                                                          Foreground="#F39C12"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="الحالة" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="8,4" HorizontalAlignment="Center">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding StatusColor}"/>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Status}"
                                                              FontWeight="SemiBold" FontSize="10"
                                                              Foreground="White"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="نسبة الدفع" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PaymentPercentage, Mode=OneWay, StringFormat={}{0:N0}%}"
                                                              FontWeight="SemiBold" HorizontalAlignment="Center"
                                                              Margin="0,0,0,4" FontSize="11"/>
                                                    <ProgressBar Value="{Binding PaymentPercentage, Mode=OneWay}"
                                                                Maximum="100" Height="4"
                                                                Foreground="#27AE60"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>
                </TabItem>

            </TabControl>
        </materialDesign:Card>
    </Grid>
</Window>
