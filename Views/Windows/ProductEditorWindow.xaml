<Window x:Class="POS_BIGA.Views.Windows.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="محرر المنتجات" 
        Width="1400" Height="900"
        WindowState="Normal"
        MinHeight="500" MinWidth="800"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        ResizeMode="CanResize">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#E74C3C"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B35"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#3498DB"/>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🎯 Header Section -->
        <Border x:Name="HeaderSection" Grid.Row="0" Background="White" Padding="20,16" Margin="0,0,0,16" 
                CornerRadius="12" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" 
                        CornerRadius="10" Padding="12" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="PackageVariant" Width="32" Height="32" 
                                            Foreground="White"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="محرر المنتجات" FontSize="22" FontWeight="Bold" 
                              Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="إضافة أو تعديل معلومات المنتج بشكل احترافي" 
                              FontSize="12" Opacity="0.7" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Save_Click"
                           Style="{StaticResource MaterialDesignRaisedButton}"
                           Background="{StaticResource SuccessBrush}"
                           Height="36" Padding="14,0" Margin="0,0,8,0"
                           ToolTip="حفظ المنتج (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="حفظ" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Click="Cancel_Click"
                           Style="{StaticResource MaterialDesignIconButton}"
                           Width="40" Height="40" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 📝 Content + Actions wrapped in ScrollViewer -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>
                <!-- 📝 Content Card -->
                <materialDesign:Card Padding="24" UniformCornerRadius="12" 
                                    Effect="{StaticResource CardShadow}" Background="White"
                                    Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 🖼️ Image Section -->
                        <materialDesign:Card Grid.Column="0" Padding="16" UniformCornerRadius="10" 
                                             VerticalAlignment="Top" Background="#FAFAFA">
                            <StackPanel>
                                <TextBlock Text="📸 صورة المنتج" FontSize="14" FontWeight="Bold" 
                                          Margin="0,0,0,12" HorizontalAlignment="Center"
                                          Foreground="{StaticResource PrimaryBrush}"/>

                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="2" 
                                       CornerRadius="8" Padding="8" Height="240" Width="280"
                                       Effect="{StaticResource CardShadow}" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding ImageUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                               Stretch="Uniform"
                                               MaxWidth="264" MaxHeight="224"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               ClipToBounds="True"
                                               Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding ImageUrl, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=Invert}">
                                            <materialDesign:PackIcon Kind="ImageOffOutline" Width="48" Height="48" Foreground="#90A4AE"/>
                                            <TextBlock Text="لم يتم اختيار صورة" Foreground="#90A4AE" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Button Margin="0,12,0,0" Height="44"
                                       Click="BrowseImage_Click" 
                                       Style="{StaticResource MaterialDesignRaisedButton}"
                                       Background="{StaticResource InfoBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Image" Width="20" Height="20" Margin="0,0,8,0"/>
                                        <TextBlock Text="اختيار صورة من الجهاز" FontSize="13" FontWeight="Medium"/>
                                    </StackPanel>
                                </Button>

                                <TextBox Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}" 
                                        materialDesign:HintAssist.Hint="مسار الصورة"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Margin="0,12,0,0" FontSize="11" Height="52"
                                        IsReadOnly="True"/>

                                <!-- معلومات إضافية -->
                                <Border Background="White" CornerRadius="6" Padding="10" Margin="0,16,0,0"
                                       BorderBrush="#E0E0E0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="💡 نصائح:" FontSize="12" FontWeight="Bold" 
                                                  Foreground="{StaticResource InfoBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="• استخدم صور عالية الجودة" FontSize="10" Opacity="0.7" Margin="0,0,0,3"/>
                                        <TextBlock Text="• الأبعاد المقترحة: 500×500" FontSize="10" Opacity="0.7" Margin="0,0,0,3"/>
                                        <TextBlock Text="• الحجم الأقصى: 2 ميجا" FontSize="10" Opacity="0.7"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 📋 Form Section -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <!-- 📝 معلومات أساسية -->
                            <TextBlock Text="📝 المعلومات الأساسية" FontSize="16" FontWeight="Bold" 
                                      Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                            <!-- الاسم -->
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                    materialDesign:HintAssist.Hint="اسم المنتج *"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,16" FontSize="14" Height="56"/>

                            <!-- الباركود و SKU -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        x:Name="BarcodeTextBox"
                                        Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                                        materialDesign:HintAssist.Hint="الباركود"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        FontSize="14" Height="56"
                                        PreviewTextInput="BarcodeTextBox_PreviewTextInput"
                                        PreviewKeyDown="BarcodeTextBox_PreviewKeyDown"
                                        LostFocus="BarcodeTextBox_LostFocus"/>

                                <TextBox Grid.Column="2"
                                        Text="{Binding SKU, UpdateSourceTrigger=PropertyChanged}" 
                                        materialDesign:HintAssist.Hint="SKU (رمز المنتج)"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        FontSize="14" Height="56"/>
                            </Grid>

                            <!-- 💰 الأسعار -->
                            <TextBlock Text="💰 الأسعار والتكاليف" FontSize="16" FontWeight="Bold" 
                                      Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,12"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- سعر البيع -->
                                <Border Grid.Column="0" BorderBrush="{StaticResource SuccessBrush}" 
                                       BorderThickness="2" CornerRadius="6" Padding="3">
                                    <TextBox x:Name="PriceBox" Text="{Binding Price, UpdateSourceTrigger=Explicit, Mode=TwoWay}" 
                                             materialDesign:HintAssist.Hint="💵 سعر البيع (د.م) *"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontSize="15" FontWeight="Bold" Height="56"
                                             Foreground="{StaticResource SuccessBrush}"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                             DataObject.Pasting="NumericTextBox_Pasting"
                                             LostFocus="NumericTextBox_LostFocus" />
                                </Border>

                                <!-- سعر الشراء -->
                                <Border Grid.Column="2" BorderBrush="{StaticResource AccentBrush}" 
                                       BorderThickness="2" CornerRadius="6" Padding="3">
                                    <TextBox x:Name="PurchasePriceBox" Text="{Binding PurchasePrice, UpdateSourceTrigger=Explicit, Mode=TwoWay}" 
                                             materialDesign:HintAssist.Hint="🛒 سعر الشراء (د.م)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontSize="14" Height="56"
                                             Foreground="{StaticResource AccentBrush}"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                             DataObject.Pasting="NumericTextBox_Pasting"
                                             LostFocus="NumericTextBox_LostFocus" />
                                </Border>
                            </Grid>

                            <!-- صف الجملة والتقسيط -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- سعر الجملة -->
                                <Border Grid.Column="0" BorderBrush="#1565C0" BorderThickness="2" CornerRadius="6" Padding="3">
                                    <TextBox x:Name="WholesalePriceBox" Text="{Binding WholesalePrice, UpdateSourceTrigger=Explicit, Mode=TwoWay, TargetNullValue=''}" 
                                             materialDesign:HintAssist.Hint="📦 سعر الجملة (د.م)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontSize="14" Height="56"
                                             Foreground="#1565C0"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                             DataObject.Pasting="NumericTextBox_Pasting"
                                             LostFocus="NumericTextBox_LostFocus" />
                                </Border>

                                <!-- سعر التقسيط -->
                                <Border Grid.Column="2" BorderBrush="#6A1B9A" BorderThickness="2" CornerRadius="6" Padding="3">
                                    <TextBox x:Name="InstallmentPriceBox" Text="{Binding InstallmentPrice, UpdateSourceTrigger=Explicit, Mode=TwoWay, TargetNullValue=''}" 
                                             materialDesign:HintAssist.Hint="💳 سعر التقسيط (د.م)"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontSize="14" Height="56"
                                             Foreground="#6A1B9A"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             PreviewKeyDown="NumericTextBox_PreviewKeyDown"
                                             DataObject.Pasting="NumericTextBox_Pasting"
                                             LostFocus="NumericTextBox_LostFocus"/>
                                </Border>
                            </Grid>

                            <!-- 📦 المخزون -->
                            <TextBlock Text="📦 إدارة المخزون" FontSize="16" FontWeight="Bold" 
                                      Foreground="{StaticResource InfoBrush}" Margin="0,8,0,12"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- الكمية المتوفرة -->
                                <TextBox Grid.Column="0"
                                        Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                        materialDesign:HintAssist.Hint="الكمية المتوفرة"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        FontSize="14" Height="56"/>

                                <!-- الحد الأدنى -->
                                <TextBox Grid.Column="2"
                                        Text="{Binding MinimumStock, UpdateSourceTrigger=PropertyChanged}" 
                                        materialDesign:HintAssist.Hint="الحد الأدنى"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        FontSize="14" Height="56"/>

                                <!-- الوحدة -->
                                <Grid Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" x:Name="UnitCombo" 
                                             DisplayMemberPath="Abbreviation" 
                                             SelectedValuePath="Id" 
                                             SelectedValue="{Binding UnitId, Mode=TwoWay}"
                                             SelectionChanged="UnitCombo_SelectionChanged"
                                             materialDesign:HintAssist.Hint="الوحدة"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                             FontSize="14" Height="56"/>

                                    <Button Grid.Column="1" Width="44" Height="44" 
                                           Margin="6,6,0,0" Click="OpenUnits_Click" 
                                           ToolTip="إدارة الوحدات"
                                            Visibility="Hidden"
                                           Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="Cog" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- الفئة -->
                            <ComboBox x:Name="CategoryCombo" 
                                     ItemsSource="{x:Null}" 
                                     DisplayMemberPath="Name" 
                                     SelectedValuePath="Id" 
                                     SelectedValue="{Binding CategoryId, Mode=TwoWay}"
                                     materialDesign:HintAssist.Hint="🏷️ الفئة *"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     Margin="0,0,0,16" FontSize="14" Height="56"/>

                            <!-- الوصف -->
                            <TextBlock Text="📄 الوصف" FontSize="16" FontWeight="Bold" 
                                      Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,12"/>

                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                    materialDesign:HintAssist.Hint="وصف تفصيلي للمنتج"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Height="100" 
                                    TextWrapping="Wrap" 
                                    AcceptsReturn="True"
                                    VerticalScrollBarVisibility="Auto"
                                    FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- ✅ Actions Section -->
                <Border Background="White" Padding="20,16" Margin="0,0,0,0"
                        CornerRadius="12" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- معلومات إضافية -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" 
                                                    Foreground="{StaticResource InfoBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="الحقول المميزة بـ (*) إلزامية" FontSize="12" Opacity="0.7"/>
                        </StackPanel>

                        <!-- الأزرار -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Width="150" Height="46" Margin="0,0,12,0"
                                   Click="Save_Click" 
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Background="{StaticResource SuccessBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="22" Height="22" Margin="0,0,8,0"/>
                                    <TextBlock Text="حفظ المنتج" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Width="130" Height="46"
                                   Click="Cancel_Click" 
                                   Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Margin="0,0,6,0"/>
                                    <TextBlock Text="إلغاء" FontSize="14" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>