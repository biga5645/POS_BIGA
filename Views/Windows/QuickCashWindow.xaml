<Window x:Class="POS_BIGA.Views.Windows.QuickCashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الدفع السريع" WindowStyle="None" ResizeMode="NoResize"
        Width="800" Height="500" Background="Transparent"
        AllowsTransparency="True" WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated"
        FlowDirection="RightToLeft" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MinWidth="360" MinHeight="320">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0078D7"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#005A9E"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>

        <Style x:Key="ModernCashButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="#EEE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" />
                            </Border.Effect>
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                <Border x:Name="Over" Background="Black" Opacity="0" CornerRadius="12"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D7" />
                                <Setter TargetName="Over" Property="Opacity" Value="0.05" />
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickCashImageStyle" TargetType="Image">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterActionButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="0" BorderThickness="0" Margin="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.24" />
        </Border.Effect>

        <Grid Loaded="Window_Loaded">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="60"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="0" Padding="14,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💵" FontSize="20" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="مركز الدفع السريع" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="اختر فئة نقدية لإضافتها بسرعة" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- أزرار الفئات النقدية -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <UniformGrid x:Name="CashButtonsGrid" Columns="4" Rows="3" Margin="6">
                <!-- Buttons for quick cash amounts -->
                <Button Click="QuickAmount_Click" Tag="0.5" Style="{StaticResource ModernCashButton}">
                    <Grid>
                        <Image x:Name="img0_5" Stretch="Fill" Style="{StaticResource QuickCashImageStyle}" />
                        <TextBlock Text="0.50 د.م" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=img0_5}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Click="QuickAmount_Click" Tag="1" Style="{StaticResource ModernCashButton}">
                    <Grid>
                        <Image x:Name="img1" Stretch="Fill" Style="{StaticResource QuickCashImageStyle}" />
                        <TextBlock Text="1.00 د.م" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=img1}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Click="QuickAmount_Click" Tag="2" Style="{StaticResource ModernCashButton}">
                    <Grid>
                        <Image x:Name="img2" Stretch="Fill" Style="{StaticResource QuickCashImageStyle}" />
                        <TextBlock Text="2.00 د.م" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=img2}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Click="QuickAmount_Click" Tag="5" Style="{StaticResource ModernCashButton}">
                    <Grid>
                        <Image x:Name="img5" Stretch="Fill" Style="{StaticResource QuickCashImageStyle}" />
                        <TextBlock Text="5.00 د.م" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=img5}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Click="QuickAmount_Click" Tag="10" Style="{StaticResource ModernCashButton}">
                    <Grid>
                        <Image x:Name="img10" Stretch="Fill" Style="{StaticResource QuickCashImageStyle}" />
                        <TextBlock Text="10.00 د.م" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=img10}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Click="QuickAmount_Click" Tag="20" Style="{StaticResource ModernCashButton}">
                    <Grid>
                        <Image x:Name="img20" Stretch="Fill" Style="{StaticResource QuickCashImageStyle}" />
                        <TextBlock Text="20.00 د.م" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=img20}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Click="QuickAmount_Click" Tag="50" Style="{StaticResource ModernCashButton}">
                    <Grid>
                        <Image x:Name="img50" Stretch="Fill" Style="{StaticResource QuickCashImageStyle}" />
                        <TextBlock Text="50.00 د.م" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=img50}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Click="QuickAmount_Click" Tag="100" Style="{StaticResource ModernCashButton}">
                    <Grid>
                        <Image x:Name="img100" Stretch="Fill" Style="{StaticResource QuickCashImageStyle}" />
                        <TextBlock Text="100.00 د.م" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=img100}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <Button Click="QuickAmount_Click" Tag="200" Style="{StaticResource ModernCashButton}">
                    <Grid>
                        <Image x:Name="img200" Stretch="Fill" Style="{StaticResource QuickCashImageStyle}" />
                        <TextBlock Text="200.00 د.م" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=img200}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

            </UniformGrid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#EEF6FF" CornerRadius="10" Padding="10,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="الإجمالي المحدد:" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <TextBlock x:Name="PreviewText" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="تصفير" Width="100" Height="40" Background="#90A4AE"
                                Style="{StaticResource FooterActionButton}" Click="Reset_Click" Margin="0,0,6,0"/>
                        <Button Content="إغلاق" Width="100" Height="40"
                                Background="{StaticResource PrimaryBrush}"
                                Style="{StaticResource FooterActionButton}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>