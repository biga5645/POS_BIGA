<Window x:Class="POS_BIGA.Views.Windows.CustomerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:behaviors="clr-namespace:POS_BIGA.Behaviors"
        Title="تفاصيل العميل الشاملة" 
        WindowState="Maximized"
        MinHeight="800" MinWidth="1200"
        FlowDirection="RightToLeft" 
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        behaviors:WindowCloseBehavior.DialogResult="{Binding DialogResult}">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E74C3C"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F39C12"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#3498DB"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#9B59B6"/>
        
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style x:Key="StatCard" TargetType="materialDesign:Card">
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="UniformCornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Customer Info -->
        <materialDesign:Card Grid.Row="0" Margin="20,20,20,16" Padding="20" 
                             UniformCornerRadius="12" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Customer Info -->
                <Border Grid.Column="0" Background="{StaticResource InfoBrush}" 
                        CornerRadius="50" Width="80" Height="80" Margin="0,0,20,0">
                    <TextBlock FontSize="32" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Run Text="{Binding Customer.FullName, Mode=OneWay}"/>
                    </TextBlock>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Customer.FullName}" FontSize="26" FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <materialDesign:PackIcon Kind="Phone" Width="18" Height="18" 
                                                Foreground="{StaticResource InfoBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Customer.Phone}" FontSize="14" Margin="0,0,20,0"/>
                        
                        <materialDesign:PackIcon Kind="Email" Width="18" Height="18" 
                                                Foreground="{StaticResource InfoBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Customer.Email}" FontSize="14" Margin="0,0,20,0"/>
                        
                        <materialDesign:PackIcon Kind="MapMarker" Width="18" Height="18" 
                                                Foreground="{StaticResource InfoBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Customer.Address}" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <materialDesign:PackIcon Kind="Calendar" Width="18" Height="18" 
                                                Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Customer.CreatedAt, StringFormat='عميل منذ: {0:yyyy-MM-dd}'}" 
                                  FontSize="13" Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding EditCustomerCommand}"
                            Width="44" Height="44" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            Background="{StaticResource InfoBrush}"
                            ToolTip="تعديل بيانات العميل">
                        <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20"/>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Width="44" Height="44" Margin="0,0,8,0"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            Background="{StaticResource SuccessBrush}"
                            ToolTip="تحديث">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                    </Button>

                    <Button Command="{Binding CloseCommand}"
                            Width="44" Height="44"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            Background="{StaticResource AccentBrush}"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- Statistics Cards -->
        <UniformGrid Grid.Row="1" Columns="5" Rows="1" Margin="20,0,20,16">
            <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource AccentBrush}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AlertCircle" Width="28" Height="28" 
                                            Foreground="White" Opacity="0.9" Margin="0,0,0,8"/>
                    <TextBlock Text="إجمالي الديون" FontSize="12" Foreground="White" Opacity="0.85"/>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0">
                        <Run Text="{Binding TotalDebt, Mode=OneWay, StringFormat={}{0:N2}}"/>
                        <Run Text=" د.م" FontSize="14"/>
                    </TextBlock>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource SuccessBrush}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="CheckCircle" Width="28" Height="28" 
                                            Foreground="White" Opacity="0.9" Margin="0,0,0,8"/>
                    <TextBlock Text="المدفوع" FontSize="12" Foreground="White" Opacity="0.85"/>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0">
                        <Run Text="{Binding TotalPaid, Mode=OneWay, StringFormat={}{0:N2}}"/>
                        <Run Text=" د.م" FontSize="14"/>
                    </TextBlock>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource WarningBrush}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="ClockAlert" Width="28" Height="28" 
                                            Foreground="White" Opacity="0.9" Margin="0,0,0,8"/>
                    <TextBlock Text="المتبقي" FontSize="12" Foreground="White" Opacity="0.85"/>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0">
                        <Run Text="{Binding TotalRemaining, Mode=OneWay, StringFormat={}{0:N2}}"/>
                        <Run Text=" د.م" FontSize="14"/>
                    </TextBlock>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource InfoBrush}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="28" Height="28" 
                                            Foreground="White" Opacity="0.9" Margin="0,0,0,8"/>
                    <TextBlock Text="عدد الديون" FontSize="12" Foreground="White" Opacity="0.85"/>
                    <TextBlock Text="{Binding Credits.Count}" FontSize="26" FontWeight="Bold" 
                              Foreground="White" Margin="0,4,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource StatCard}" Background="{StaticResource PurpleBrush}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="CreditCard" Width="28" Height="28" 
                                            Foreground="White" Opacity="0.9" Margin="0,0,0,8"/>
                    <TextBlock Text="سقف الكريدي" FontSize="12" Foreground="White" Opacity="0.85"/>
                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0">
                        <Run Text="{Binding Customer.CreditLimit, StringFormat={}{0:N2}}"/>
                        <Run Text=" د.م" FontSize="14"/>
                    </TextBlock>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <!-- Tabs -->
        <materialDesign:Card Grid.Row="2" Margin="20,0,20,20" 
                             UniformCornerRadius="16" Effect="{StaticResource CardShadow}">
            <TabControl Style="{StaticResource MaterialDesignFilledTabControl}">
                
                <!-- Tab 1: Credits List -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="12,6">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="الديون" FontSize="13" FontWeight="SemiBold" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Quick Actions -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Command="{Binding AddPaymentCommand}"
                                    Width="140" Height="44"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource SuccessBrush}"
                                    IsEnabled="{Binding HasUnpaidCredits, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashPlus" Width="18" Height="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="إضافة دفعة" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExportCreditsCommand}"
                                    Width="120" Height="44" Margin="12,0,0,0"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{StaticResource InfoBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExport" Width="18" Height="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="تصدير" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Credits DataGrid -->
                        <DataGrid Grid.Row="1"
                                 ItemsSource="{Binding Credits}" 
                                 SelectedItem="{Binding SelectedCredit}"
                                 AutoGenerateColumns="False" 
                                 CanUserAddRows="False"
                                 IsReadOnly="True"
                                 SelectionMode="Single"
                                 HeadersVisibility="All"
                                 GridLinesVisibility="Horizontal"
                                 AlternatingRowBackground="#F8F9FA"
                                 RowHeight="58"
                                 FontSize="13"
                                 materialDesign:DataGridAssist.CellPadding="10">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="44"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding SaleNumber}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource InfoBrush}"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="التاريخ" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" 
                                                          FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}" 
                                                          FontSize="10" Opacity="0.6"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="المبلغ الأصلي" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFEBEE" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{Binding OriginalAmount, StringFormat={}{0:N2}}" 
                                                          FontWeight="Bold" HorizontalAlignment="Center"
                                                          Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="المدفوع" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8F5E9" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N2}}" 
                                                          FontWeight="Bold" HorizontalAlignment="Center"
                                                          Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="المتبقي" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF3E0" CornerRadius="8" Padding="8,4">
                                                <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N2}}" 
                                                          FontWeight="Bold" HorizontalAlignment="Center"
                                                          Foreground="{StaticResource WarningBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="نسبة الدفع" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding PaymentPercentage, Mode=OneWay, StringFormat={}{0:N0}%}" 
                                                          FontWeight="SemiBold" HorizontalAlignment="Center"
                                                          Margin="0,0,0,4" FontSize="11"/>
                                                <ProgressBar Value="{Binding PaymentPercentage, Mode=OneWay}" 
                                                            Maximum="100" Height="4"
                                                            Foreground="{StaticResource SuccessBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الحالة" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,4" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Unpaid">
                                                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="PartiallyPaid">
                                                                <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" 
                                                          FontWeight="SemiBold" FontSize="11"
                                                          Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*" MinWidth="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Opacity" Value="0.75"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="الإجراءات" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.PayCreditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"
                                                       Style="{StaticResource MaterialDesignIconButton}"
                                                       ToolTip="دفع"
                                                       Width="32" Height="32"
                                                       IsEnabled="{Binding HasRemainingAmount}">
                                                    <materialDesign:PackIcon Kind="CashCheck" Width="16" Height="16" 
                                                                            Foreground="{StaticResource SuccessBrush}"/>
                                                </Button>

                                                <Button Command="{Binding DataContext.ViewInvoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"
                                                       Style="{StaticResource MaterialDesignIconButton}"
                                                       ToolTip="عرض الفاتورة"
                                                       Width="32" Height="32" Margin="4,0,0,0">
                                                    <materialDesign:PackIcon Kind="FileDocument" Width="16" Height="16" 
                                                                            Foreground="{StaticResource InfoBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Payment History -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="12,6">
                            <materialDesign:PackIcon Kind="History" Width="18" Height="18" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="سجل المدفوعات" FontSize="13" FontWeight="SemiBold" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <DataGrid Margin="16"
                             ItemsSource="{Binding Payments}" 
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             HeadersVisibility="All"
                             GridLinesVisibility="Horizontal"
                             AlternatingRowBackground="#F8F9FA"
                             RowHeight="54"
                             FontSize="13"
                             materialDesign:DataGridAssist.CellPadding="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المعرف" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding CreditSaleNumber}" Width="120"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                            <DataGridTextColumn Header="المبلغ المدفوع" Binding="{Binding Amount, StringFormat={}{0:N2} د.م}" Width="130"/>
                            <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="120"/>
                            <DataGridTextColumn Header="المستلم" Binding="{Binding ReceivedBy}" Width="150"/>
                            <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Tab 3: Sales History -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Margin="12,6">
                            <materialDesign:PackIcon Kind="ShoppingOutline" Width="18" Height="18" 
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="سجل المشتريات" FontSize="13" FontWeight="SemiBold" 
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <DataGrid Margin="16"
                             ItemsSource="{Binding Sales}" 
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False"
                             IsReadOnly="True"
                             SelectionMode="Single"
                             HeadersVisibility="All"
                             GridLinesVisibility="Horizontal"
                             AlternatingRowBackground="#F8F9FA"
                             RowHeight="54"
                             FontSize="13"
                             materialDesign:DataGridAssist.CellPadding="10">

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🖨️ إعادة طباعة الفاتورة" 
                                         Command="{Binding PrintSaleCommand}"
                                         CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                         FontSize="14" FontWeight="SemiBold">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="📄 عرض تفاصيل الفاتورة" 
                                         Command="{Binding ViewSaleDetailsCommand}"
                                         CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                         FontSize="14">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding SaleNumber}" Width="130"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding SaleDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                            <DataGridTextColumn Header="الأصناف" Binding="{Binding ItemsCount}" Width="80"/>
                            <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="120"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2} د.م}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </materialDesign:Card>
    </Grid>
</Window>



