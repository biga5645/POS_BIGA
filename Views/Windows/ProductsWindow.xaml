<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:POS_BIGA.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="POS_BIGA.Views.Windows.ProductsWindow"
        Title="إدارة المنتجات" 
        WindowState="Maximized"
        MinHeight="800" MinWidth="1200"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#D32F2F"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6B35"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFA726"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#1976D2"/>

        <Style x:Key="SectionTitleText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <conv:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🎯 Header Section -->
        <materialDesign:Card Grid.Row="0" Padding="14,10" Margin="0,0,0,8"
                             UniformCornerRadius="12" Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShoppingOutline" Width="24" Height="24"
                                            Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="إدارة المنتجات" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="لوحة احترافية لإدارة المنتجات" FontSize="11" Opacity="0.65"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ProductsColumnsButton"
                            Click="ProductsColumnsButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="اختيار الأعمدة" Margin="0,0,8,0" Padding="10,6">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="الصورة" IsCheckable="True" IsChecked="True" Tag="ProductsImageColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="ID" IsCheckable="True" IsChecked="True" Tag="ProductsIdColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="اسم المنتج" IsCheckable="True" IsChecked="True" Tag="ProductsNameColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="الباركود" IsCheckable="True" IsChecked="True" Tag="ProductsBarcodeColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="الفئة" IsCheckable="True" IsChecked="True" Tag="ProductsCategoryColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="الكمية" IsCheckable="True" IsChecked="True" Tag="ProductsQuantityColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="الوحدة" IsCheckable="True" IsChecked="True" Tag="ProductsUnitColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="سعر البيع" IsCheckable="True" IsChecked="True" Tag="ProductsSalePriceColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="سعر الشراء" IsCheckable="True" IsChecked="True" Tag="ProductsPurchasePriceColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="سعر الجملة" IsCheckable="True" IsChecked="True" Tag="ProductsWholesaleColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="سعر التقسيط" IsCheckable="True" IsChecked="True" Tag="ProductsInstallmentColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="قيمة المخزون" IsCheckable="True" IsChecked="True" Tag="ProductsStockValueColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <MenuItem Header="الإجراءات" IsCheckable="True" IsChecked="True" Tag="ProductsActionsColumn" Click="ProductsColumnVisibilityMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="إظهار كل الأعمدة" Click="ResetProductsColumns_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TableColumn" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="الأعمدة"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" ToolTip="تحديث" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                    </Button>
                    <Button Click="CloseWindow_Click" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" ToolTip="إغلاق" Background="{StaticResource WarningBrush}">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- المحتوى: لوحة علوية + جدول بكامل العرض -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- لوحة علوية (بحث + فلاتر + إجراءات) -->
            <materialDesign:Card Grid.Row="0" Padding="10" Margin="0,0,0,8" UniformCornerRadius="12" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- صف البحث + إضافة + الفئة -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#C5D8F0" BorderThickness="1.5" CornerRadius="10" Padding="4,2" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.10" Color="#1976D2"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="20" Height="20"
                                                         VerticalAlignment="Center" Foreground="#1976D2" Margin="10,0,4,0" />
                                <TextBox Grid.Column="1" x:Name="ProductsSearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="ابحث بالاسم أو الباركود..."
                                         materialDesign:HintAssist.IsFloating="False"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" FontSize="14"
                                         PreviewTextInput="SearchBox_PreviewTextInput"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"
                                         LostFocus="SearchBox_LostFocus"
                                         Background="Transparent" BorderThickness="0" Padding="4,8"
                                         VerticalContentAlignment="Center" Height="40" />
                                <materialDesign:PackIcon Grid.Column="2" Kind="Barcode" Width="18" Height="18"
                                                         VerticalAlignment="Center" Foreground="#94A3B8" Margin="4,0,10,0"
                                                         ToolTip="يدعم قراءة الكود البار مباشرة" />
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Height="36" MinWidth="120"
                                Click="OpenAddProductInPlace_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource SuccessBrush}"
                                Visibility="{Binding CanAddProduct, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="إضافة منتج"/>
                            </StackPanel>
                        </Button>

                        <ComboBox Grid.Column="4" Width="220" ItemsSource="{Binding FilterCategories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategoryFilter}"
                                  materialDesign:HintAssist.Hint="الفئة"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    </Grid>

                    <!-- صف الأزرار -->
                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <Button Height="36" MinWidth="95" Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource InfoBrush}" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="بحث"/></StackPanel>
                        </Button>
                        <ToggleButton Width="45" Height="36" IsChecked="{Binding IsAdvancedSearchVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignActionToggleButton}" ToolTip="بحث متقدم" Margin="0,0,8,8">
                            <materialDesign:PackIcon Kind="TuneVariant" Width="18" Height="18"/>
                        </ToggleButton>
                        <Button Height="36" MinWidth="120" Style="{StaticResource MaterialDesignOutlinedButton}" Click="OpenCategories_Click" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Tag" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="إدارة الفئات"/></StackPanel>
                        </Button>
                        <Button Height="36" MinWidth="120" Style="{StaticResource MaterialDesignOutlinedButton}" Click="OpenUnits_Click" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="WeightKilogram" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="إدارة الوحدات"/></StackPanel>
                        </Button>
                        <Button Height="36" MinWidth="120" Style="{StaticResource MaterialDesignOutlinedButton}" Click="ShowProductsTable_Click" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Table" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="جدول المنتجات"/></StackPanel>
                        </Button>
                        <Button Height="36" MinWidth="135" Command="{Binding ExportProductsExcelCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,8"
                                Visibility="{Binding CanImportExportProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileExport" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="تصدير Excel"/></StackPanel>
                        </Button>
                        <Button Height="36" MinWidth="135" Command="{Binding ImportProductsExcelCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,8"
                                Visibility="{Binding CanImportExportProducts, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileImport" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="استيراد Excel"/></StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- البحث المتقدم -->
                    <materialDesign:Card Grid.Row="2" Padding="10" UniformCornerRadius="8">
                        <materialDesign:Card.Style>
                            <Style TargetType="{x:Type materialDesign:Card}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdvancedSearchVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:Card.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="170" Text="{Binding MinPriceText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="السعر الأدنى" materialDesign:HintAssist.IsFloating="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
                            <TextBox Width="170" Text="{Binding MaxPriceText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="السعر الأقصى" materialDesign:HintAssist.IsFloating="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0"/>
                            <CheckBox Content="المنتجات المتوفرة فقط" IsChecked="{Binding InStockOnly}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </materialDesign:Card>

            <!-- الجدول -->
            <materialDesign:Card Grid.Row="1" Padding="0" UniformCornerRadius="12" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- زر الرجوع - يظهر فقط عند عرض صفحة مضمّنة -->
                            <Button x:Name="BackToProductsButton"
                                    Grid.Column="0"
                                    Click="ShowProductsTable_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Height="34" Margin="0,0,12,0"
                                    Visibility="Collapsed"
                                    ToolTip="رجوع إلى جدول المنتجات">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="رجوع" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Column="1"
                                       x:Name="ContentAreaTitle"
                                       Text="جدول المنتجات"
                                       FontSize="16" FontWeight="Bold" Foreground="#334155"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="ProductsGrid"
                             SizeChanged="ProductsGrid_SizeChanged"
                             ItemsSource="{Binding Products}" 
                             AutoGenerateColumns="False" 
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             CanUserResizeRows="False"
                             CanUserResizeColumns="True"
                             SelectionMode="Single"
                             SelectionUnit="FullRow"
                             IsReadOnly="False"
                             HeadersVisibility="All"
                             RowHeaderWidth="0"
                             GridLinesVisibility="Horizontal"
                             AlternatingRowBackground="{DynamicResource MaterialDesignDivider}"
                             ColumnHeaderHeight="52"
                             RowHeight="80"
                             FontSize="15"
                             MinWidth="980"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLength="6"
                             VirtualizingPanel.CacheLengthUnit="Item"
                             EnableRowVirtualization="True"
                             EnableColumnVirtualization="True"
                             materialDesign:DataGridAssist.CellPadding="8"
                             materialDesign:DataGridAssist.ColumnHeaderPadding="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.IsDeferredScrollingEnabled="False"
                             CellEditEnding="ProductsGrid_CellEditEnding">
                        <DataGrid.Resources>
                            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="Height" Value="52"/>
                            </Style>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="ToolTip" Value="انقر مرتين للتعديل السريع"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F9FF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EAF3FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- صورة المنتج -->
                            <DataGridTemplateColumn x:Name="ProductsImageColumn" Header="الصورة" Width="86">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="52" Height="52" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill">
                                                <Image.ToolTip>
                                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8" CornerRadius="8">
                                                        <Image Source="{Binding ImageUrl, Converter={StaticResource StringToImageSourceConverter}}" Width="180" Height="180" Stretch="Uniform"/>
                                                    </Border>
                                                </Image.ToolTip>
                                            </Image>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ID -->
                            <DataGridTextColumn x:Name="ProductsIdColumn" Header="ID" Binding="{Binding Id}" Width="65"/>

                            <!-- اسم المنتج -->
                            <DataGridTextColumn x:Name="ProductsNameColumn" Header="اسم المنتج" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- باركود -->
                            <DataGridTemplateColumn x:Name="ProductsBarcodeColumn" Header="الباركود" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Barcode}" FontFamily="Consolas"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   ToolTip="انقر مرتين للتعديل"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas" TextAlignment="Center"
                                                 BorderThickness="1" BorderBrush="#1976D2"
                                                 Background="#E3F2FD" Padding="4,2"
                                                 FontSize="13"
                                                 materialDesign:HintAssist.Hint="الباركود"
                                                 GotFocus="EditableCell_GotFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- الفئة -->
                            <DataGridTextColumn x:Name="ProductsCategoryColumn" Header="الفئة" Binding="{Binding CategoryName}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- الكمية -->
                            <DataGridTemplateColumn x:Name="ProductsQuantityColumn" Header="الكمية" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StockQuantity, StringFormat={}{0:N1}}"
                                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource InfoBrush}"
                                                   ToolTip="انقر مرتين للتعديل"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding StockQuantity, StringFormat={}{0:N1}, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center" FontWeight="Bold"
                                                 Foreground="{StaticResource InfoBrush}"
                                                 BorderThickness="1" BorderBrush="{StaticResource InfoBrush}"
                                                 Background="#E3F2FD" Padding="4,2"
                                                 FontSize="13"
                                                 PreviewTextInput="NumericCell_PreviewTextInput"
                                                 GotFocus="EditableCell_GotFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- الوحدة -->
                            <DataGridTextColumn x:Name="ProductsUnitColumn" Header="الوحدة" Binding="{Binding Unit}" Width="90" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- السعر -->
                            <DataGridTemplateColumn x:Name="ProductsSalePriceColumn" Header="سعر البيع" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N2}}"
                                                   FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   ToolTip="انقر مرتين للتعديل"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SalePrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center" FontWeight="Bold"
                                                 Foreground="{StaticResource SuccessBrush}"
                                                 BorderThickness="1" BorderBrush="{StaticResource SuccessBrush}"
                                                 Background="#E8F5E9" Padding="4,2"
                                                 FontSize="14"
                                                 PreviewTextInput="NumericCell_PreviewTextInput"
                                                 GotFocus="EditableCell_GotFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- سعر الشراء -->
                            <DataGridTextColumn x:Name="ProductsPurchasePriceColumn" Header="سعر الشراء" Binding="{Binding PurchasePrice, StringFormat=\{0:N2\}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- سعر الجملة -->
                            <DataGridTextColumn x:Name="ProductsWholesaleColumn" Header="سعر الجملة" Binding="{Binding WholesalePrice, StringFormat=\{0:N2\}, TargetNullValue=—}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1565C0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- سعر التقسيط -->
                            <DataGridTextColumn x:Name="ProductsInstallmentColumn" Header="سعر التقسيط" Binding="{Binding InstallmentPrice, StringFormat=\{0:N2\}, TargetNullValue=—}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#6A1B9A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- قيمة المخزون -->
                            <DataGridTextColumn x:Name="ProductsStockValueColumn" Header="قيمة المخزون" Binding="{Binding StockValue, StringFormat=\{0:N2\}}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- إجراءات -->
                            <DataGridTemplateColumn x:Name="ProductsActionsColumn" Header="الإجراءات" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Width="70" Height="32" Margin="4,0"
                                       Style="{StaticResource MaterialDesignOutlinedButton}"
                                       BorderBrush="{StaticResource InfoBrush}"
                                       Click="OpenEditProductInPlace_Click"
                                       Tag="{Binding}"
                                       ToolTip="تعديل المنتج"
                                       Visibility="{Binding DataContext.CanEditProduct, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,4,0"
                                                                            Foreground="{StaticResource InfoBrush}"/>
                                                    <TextBlock Text="تعديل" FontSize="12" Foreground="{StaticResource InfoBrush}"/>
                                                </StackPanel>
                                            </Button>

                                            <Button Width="70" Height="32" Margin="4,0"
                                       Style="{StaticResource MaterialDesignOutlinedButton}"
                                       BorderBrush="{StaticResource WarningBrush}"
                                       Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       CommandParameter="{Binding}"
                                       ToolTip="حذف المنتج"
                                       Visibility="{Binding DataContext.CanDeleteProduct, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,4,0"
                                                                            Foreground="{StaticResource WarningBrush}"/>
                                                    <TextBlock Text="حذف" FontSize="12" Foreground="{StaticResource WarningBrush}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Frame x:Name="EmbeddedPageHost"
                           Grid.Row="1"
                           Visibility="Collapsed"
                           NavigationUIVisibility="Hidden"/>

                    <ContentControl x:Name="EmbeddedControlHost"
                                    Grid.Row="1"
                                    Visibility="Collapsed"/>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
