<Window x:Class="POS_BIGA.Views.Windows.CreditPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تسديد ديون العميل" 
        Height="680" Width="600"
        FlowDirection="RightToLeft" 
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA"
        ResizeMode="NoResize">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E74C3C"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#27AE60"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F39C12"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#3498DB"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- المحتوى القابل للتمرير -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel>

                <!-- Header -->
                <materialDesign:Card Padding="20,16" Margin="0,0,0,16"
                                     UniformCornerRadius="12" Effect="{StaticResource CardShadow}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{StaticResource AccentBrush}" 
                                CornerRadius="12" Padding="12" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="CashCheck" Foreground="White" Width="28" Height="28"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="تسديد ديون العميل" FontSize="22" FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding CustomerName}" FontSize="13" Opacity="0.7" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Summary Info -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                     UniformCornerRadius="12" Effect="{StaticResource CardShadow}"
                                     Background="{StaticResource InfoBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="عدد الفواتير" FontSize="12" Foreground="White" Opacity="0.85" 
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding UnpaidInvoicesCount, Mode=OneWay}" FontSize="32" FontWeight="Bold" 
                                      Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Separator Grid.Column="1" Width="2" Margin="20,0" Background="White" Opacity="0.3"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="إجمالي الديون" FontSize="12" Foreground="White" Opacity="0.85"
                                      HorizontalAlignment="Center"/>
                            <TextBlock FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"
                                      HorizontalAlignment="Center">
                                <Run Text="{Binding TotalDebt, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                <Run Text=" د.م" FontSize="18"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- Amount Summary -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                     UniformCornerRadius="12" Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="إجمالي الديون المتبقية:" 
                                  FontSize="15" FontWeight="Bold" Margin="0,6"
                                  Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="18" FontWeight="Bold" Margin="0,6"
                                  Foreground="{StaticResource AccentBrush}">
                            <Run Text="{Binding TotalDebt, Mode=OneWay, StringFormat={}{0:N2}}"/>
                            <Run Text=" د.م"/>
                        </TextBlock>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource WarningBrush}" 
                               CornerRadius="8" Padding="12,8" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="سيتبقى بعد الدفع:" FontSize="14" FontWeight="SemiBold" 
                                          Foreground="White"/>
                                <TextBlock Grid.Column="1" FontSize="16" FontWeight="Bold" Foreground="White">
                                    <Run Text="{Binding RemainingAfter, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                    <Run Text=" د.م"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- Payment Input -->
                <materialDesign:Card Padding="20" Margin="0,0,0,16"
                                     UniformCornerRadius="12" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="Cash" Width="24" Height="24" 
                                                    Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="معلومات الدفع" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Amount to Pay -->
                        <TextBox Text="{Binding AmountToPay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                materialDesign:HintAssist.Hint="💰 المبلغ المدفوع"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                FontSize="16"
                                Height="56"
                                Margin="0,0,0,12"
                                TextAlignment="Center"
                                FontWeight="Bold"
                                Foreground="{StaticResource SuccessBrush}"/>

                        <!-- Quick Amount Buttons -->
                        <UniformGrid Rows="2" Columns="3" Margin="0,0,0,12">
                            <Button Content="كامل" Command="{Binding PayFullCommand}" 
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Background="{StaticResource SuccessBrush}" Margin="4" Height="44"/>
                            <Button Content="نصف" Command="{Binding PayHalfCommand}"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Background="{StaticResource InfoBrush}" Margin="4" Height="44"/>
                            <Button Content="ربع" Command="{Binding PayQuarterCommand}"
                                   Style="{StaticResource MaterialDesignRaisedButton}"
                                   Background="{StaticResource WarningBrush}" Margin="4" Height="44"/>
                            <Button Content="100" Command="{Binding Pay100Command}"
                                   Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4" Height="44"/>
                            <Button Content="200" Command="{Binding Pay200Command}"
                                   Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4" Height="44"/>
                            <Button Content="500" Command="{Binding Pay500Command}"
                                   Style="{StaticResource MaterialDesignOutlinedButton}" Margin="4" Height="44"/>
                        </UniformGrid>

                        <!-- Payment Method -->
                        <ComboBox ItemsSource="{Binding PaymentMethods}"
                                 SelectedItem="{Binding SelectedPaymentMethod}"
                                 materialDesign:HintAssist.Hint="طريقة الدفع"
                                 Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                 FontSize="14"
                                 Height="48"
                                 Margin="0,0,0,12"/>

                        <!-- Notes -->
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                materialDesign:HintAssist.Hint="ملاحظات (اختياري)"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                FontSize="13"
                                Height="70"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding PayAndPrintCommand}"
                   Height="50" Margin="0,0,4,0"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Background="{StaticResource SuccessBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PrinterCheck" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="دفع + طباعة" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Command="{Binding PayOnlyCommand}"
                   Height="50" Margin="4,0"
                   Style="{StaticResource MaterialDesignRaisedButton}"
                   Background="{StaticResource InfoBrush}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="دفع فقط" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Command="{Binding PreviewReceiptCommand}"
                   Height="50" Width="50" Margin="4,0"
                   Style="{StaticResource MaterialDesignFloatingActionButton}"
                   Background="{StaticResource WarningBrush}"
                   ToolTip="معاينة الإيصال">
                <materialDesign:PackIcon Kind="EyeOutline" Width="24" Height="24"/>
            </Button>

            <Button Grid.Column="3" Command="{Binding CancelCommand}"
                   Height="50" Margin="4,0,0,0"
                   Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Margin="0,0,8,0"/>
                    <TextBlock Text="إلغاء" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
