<UserControl x:Class="POS_BIGA.Views.Controls.InventoryAdvancedStatsControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" FlowDirection="RightToLeft"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Advanced Inventory Statistics" FontSize="22" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,12"/><Button Grid.Column="1" Click="BackToTable_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="8,0,0,8"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ArrowRight" Width="16" Height="16" Margin="0,0,6,0"/><TextBlock Text="Back to Table"/></StackPanel></Button></Grid><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><materialDesign:Card Grid.Column="0" Padding="14" Margin="0,0,8,0" UniformCornerRadius="10" Background="#FAFBFF"><StackPanel><TextBlock Text="Quick Summary" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock FontSize="14" Margin="0,2"><Run Text="Total Products: "/><Run Text="{Binding TotalProducts}" FontWeight="Bold"/></TextBlock><TextBlock FontSize="14" Margin="0,2"><Run Text="Good Stock: "/><Run Text="{Binding GoodStockCount}" FontWeight="Bold"/></TextBlock><TextBlock FontSize="14" Margin="0,2"><Run Text="Low Stock: "/><Run Text="{Binding LowStockOnlyCount}" FontWeight="Bold"/></TextBlock><TextBlock FontSize="14" Margin="0,2"><Run Text="Out of Stock: "/><Run Text="{Binding OutOfStockCount}" FontWeight="Bold"/></TextBlock><TextBlock FontSize="14" Margin="0,2"><Run Text="Stock Value: "/><Run Text="{Binding TotalStockValue, StringFormat={}{0:N2} MAD}" FontWeight="Bold"/></TextBlock></StackPanel></materialDesign:Card><materialDesign:Card Grid.Column="1" Padding="14" Margin="8,0,0,0" UniformCornerRadius="10" Background="#FAFBFF"><StackPanel><TextBlock Text="Interactive Charts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><Button Click="GoodStock_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Show good stock products" Margin="0,0,0,4"><StackPanel><TextBlock Text="Good Stock" Margin="0,0,0,4"/><ProgressBar Height="20" Maximum="{Binding TotalProducts}" Value="{Binding GoodStockCount}" Foreground="#4CAF50"/></StackPanel></Button><Button Click="LowStock_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Show low stock products" Margin="0,10,0,4"><StackPanel><TextBlock Text="Low Stock" Margin="0,0,0,4"/><ProgressBar Height="20" Maximum="{Binding TotalProducts}" Value="{Binding LowStockOnlyCount}" Foreground="#FFA726"/></StackPanel></Button><Button Click="OutOfStock_Click" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Show out-of-stock products" Margin="0,10,0,4"><StackPanel><TextBlock Text="Out of Stock" Margin="0,0,0,4"/><ProgressBar Height="20" Maximum="{Binding TotalProducts}" Value="{Binding OutOfStockCount}" Foreground="#F44336"/></StackPanel></Button></StackPanel></materialDesign:Card></Grid></Grid></UserControl>
