<UserControl x:Class="POS_BIGA.Views.Controls.CheckoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:POS_BIGA.ViewModels"
             xmlns:models="clr-namespace:POS_BIGA.Models"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:POS_BIGA.Converters"
             FlowDirection="RightToLeft" FontFamily="Segoe UI"
             Height="Auto" Width="Auto">

    <UserControl.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D32F2F" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

        <Style TargetType="Control" x:Key="TouchInputStyle">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource TouchInputStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource TouchInputStyle}" />

        <Style TargetType="Button" x:Key="ActionTouchButton">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="10" Padding="15" VerticalAlignment="Bottom" MaxHeight="360">
        <Border.Effect>
            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.05" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- compact price type row -->
                <RowDefinition Height="Auto" />
                <!-- top inputs (customer + amount) -->
                <RowDefinition Height="Auto" />
                <!-- actions area: keep compact so control doesn't grow and leaves space for cart -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ══ نوع السعر (compact) ══ -->
            <Border Grid.Row="0" Background="#F8FBFF" CornerRadius="6" Padding="6,6" 
                    BorderBrush="#E6F0FF" BorderThickness="1" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="نوع السعر:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton Content="تجزئة" GroupName="PriceTypeGroup" Margin="0,0,12,0"
                                 FontSize="12" FontWeight="SemiBold" Foreground="#388E3C" Cursor="Hand"
                                 IsChecked="{Binding GlobalPriceType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Retail}"/>
                    <RadioButton Content="جملة" GroupName="PriceTypeGroup" Margin="0,0,12,0"
                                 FontSize="12" FontWeight="SemiBold" Foreground="#1565C0" Cursor="Hand"
                                 IsChecked="{Binding GlobalPriceType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Wholesale}"/>
                    <RadioButton Content="تقسيط" GroupName="PriceTypeGroup" Margin="0,0,0,0"
                                 FontSize="12" FontWeight="SemiBold" Foreground="#6A1B9A" Cursor="Hand"
                                 IsChecked="{Binding GlobalPriceType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Installment}"/>
                </StackPanel>
            </Border>

            <!-- Top area: customer + amount -->
            <Grid Grid.Row="1">
                 <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Customer selector -->
                <StackPanel Grid.Column="0" Grid.Row="0">
                    <TextBlock Text="الزبون (اختياري):" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" 
                                  ItemsSource="{Binding Customers}"
                                  DisplayMemberPath="FullName"
                                  SelectedItem="{Binding SelectedCustomer}"
                                  materialDesign:HintAssist.Hint="🚫 زبون عام (أو اختر من القائمة)"
                                  MinWidth="140" MaxWidth="320" />

                        <Button Grid.Column="1" 
                                Content="❌" 
                                Width="36" Height="36" 
                                Margin="6,0,0,0"
                                Background="#EF4444" 
                                Foreground="White" 
                                FontSize="16"
                                Tag="ResponsiveScale"
                                 ToolTip="إلغاء الاختيار (زبون عام)"
                                 Cursor="Hand"
                                 Click="ClearCustomer_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- payment method removed: keep a hidden placeholder if needed -->
                    <TextBlock Text="طريقة الدفع: نقداً" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>

                <!-- Amount and quick cash -->
                <StackPanel Grid.Column="2" Grid.Row="0">
                    <TextBlock Text="المبلغ المدفوع (د.م):" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AmountTextBox" Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}"
                                 FontWeight="Bold" FontSize="18" TextAlignment="Center" MinWidth="120" Width="140" />

                        <Button Grid.Column="1" Content="💵" Width="45" Height="45" Margin="4,0,0,0"
                                Background="#0078D7" Foreground="White" FontSize="20"
                                Tag="ResponsiveScale"
                                Command="{Binding OpenQuickCashCommand}" Cursor="Hand"
                                ToolTip="فتح نافذة الدفع السريع (F4)">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Small remaining display next to amount -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
                        <TextBlock Width="8" />
                        <TextBlock Text="{Binding RemainingText}" FontWeight="Bold" FontSize="16" Foreground="{Binding RemainingBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Bottom area: actions -->
            <Grid Grid.Row="2" x:Name="ActionsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="2.9*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelButton" Grid.Column="0" Content="إلغاء ❌"
                        Margin="4"
                        MinWidth="96"
                        Background="{StaticResource DangerBrush}"
                        Tag="ResponsiveScale"
                        Style="{StaticResource ActionTouchButton}"
                        Command="{Binding CancelCommand}" />

                <Grid Grid.Column="1" x:Name="ActionButtonsGrid" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="SuspendCartButton" Grid.Row="0" Grid.Column="0" Height="48" Margin="4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.SuspendCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Tag="ResponsiveScale"
                            Style="{StaticResource ActionTouchButton}" Background="#FF8A65"
                            Visibility="{Binding DataContext.CanSuspendCart, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Pause" Width="18" Height="18" Margin="0,0,6,0" />
                            <TextBlock Text="تعليق السلة" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ShowSuspendedCartsButton" Grid.Row="0" Grid.Column="1" Height="48" Margin="4"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DataContext.ShowSuspendedCartsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Tag="ResponsiveScale"
                            Style="{StaticResource ActionTouchButton}" Background="#7986CB"
                            Visibility="{Binding DataContext.CanSuspendCart, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="ViewList" Width="18" Height="18" Margin="0,0,6,0" />
                            <TextBlock Text="السلات المعلقة" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="CompletePaymentButton" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="56" Margin="4"
                            Background="{StaticResource SuccessBrush}"
                            Tag="ResponsiveScale"
                            Style="{StaticResource ActionTouchButton}"
                            Visibility="{Binding DataContext.ShowingCart, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding CompleteCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckBold" Width="20" Height="20" Margin="0,0,8,0" />
                            <TextBlock Text="إتمام عملية الدفع" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>